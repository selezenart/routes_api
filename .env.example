# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# From developers.deutschebahn.com -> your application -> Berechtigungsnachweise
DB_CLIENT_ID=
DB_API_KEY=

# Local PostgreSQL from docker-compose.yml (run: docker compose up -d db).
# Leave commented out to use a local SQLite file (tracker.db) instead.
# DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
